# =============================================================================
# Contexto de build de la imagen (Railway usa el Dockerfile de la raíz).
# Fase 5A: excluir estado local, secretos, artefactos y APK no validado.
# Docker no hereda .gitignore; este archivo debe ser autónomo.
# =============================================================================

# Git, repos anidados y editores
.git
**/.git
.vscode
.idea
**/.DS_Store
**/Thumbs.db
**/.github

# Dependencias y artefactos de build/pruebas
**/node_modules
**/vendor
frontend/dist
frontend/coverage
frontend/test-results
frontend/playwright-report
frontend/blob-report
frontend/e2e
frontend/agentes-reportes
frontend/docs
frontend/vite.log
frontend/playwright.config.js
frontend/vitest.config.js
frontend/eslint.config.js
backend/tests
backend/test-results
backend/phpunit.xml
backend/.phpunit.result.cache
backend/.phpunit.cache

# Entornos: excluir valores reales y variantes; conservar solo ejemplos
**/.env
**/.env.*
!backend/.env.example
!frontend/.env.example

# Credenciales y material sensible que no debe entrar al contexto
**/auth.json
**/.npmrc
**/.envrc
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.sqlite
**/*.sqlite3

# Laravel: estado local/runtime; el Dockerfile recrea los directorios
backend/storage
backend/bootstrap/cache
backend/public/storage

# APK: solo se incluye el artefacto autorizado en la ruta estable.
**/*.apk
!backend/public/apk/ProyecTWin.apk
**/*.aab
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx

# Documentación, logs y material ajeno al build
**/*.md
**/*.log
**/*.log.*
docs
Movil
