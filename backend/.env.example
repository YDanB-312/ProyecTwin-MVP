APP_NAME=ProyecTwin-MVP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# CIDR/IP del proxy inverso separados por coma. Vacío conserva "*" en local;
# en producción es obligatorio y no puede ser "*".
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de desarrollo local del proyecto. No la recrees, vacíes ni migres
# sin autorización específica. Las pruebas automatizadas no usan este valor:
# PHPUnit y E2E exigen bases desechables propias.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proyectwin_mvp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Minutos de inactividad de la sesión web del SPA. No es la vida del token móvil.
SESSION_LIFETIME=120
# En local HTTP puede quedar sin definir (o false) para permitir HTTP. En
# producción HTTPS la cookie siempre es Secure: false explícito, ausente o
# inválido no desactivan el atributo. También puede fijarse true aquí.
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit captura el correo real de Laravel por SMTP en 127.0.0.1:1025.
# Inicia Mailpit y consulta la bandeja en http://localhost:8025.
# Producción: configura MAIL_MAILER=brevo o un SMTP real en el .env del servidor.
#   MAIL_MAILER=brevo
#   BREVO_API_KEY=...            (app.brevo.com -> SMTP y API -> Claves API)
#   MAIL_FROM_ADDRESS=<remitente verificado en Brevo>
MAIL_MAILER=smtp
BREVO_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@proyecttwin.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173,127.0.0.1:4173
# Minutos de vida de los tokens Bearer (móvil/clientes sin sesión). Duración
# aprobada: 1440 (24 h). Al vencer, Android debe iniciar sesión de nuevo; no
# hay renovación automática. El SPA usa cookie de sesión y no depende de este
# valor.
SANCTUM_EXPIRATION=1440

# Activación de cuentas nuevas por correo (web). El vencimiento se expresa en
# minutos. Toda cuenta nueva nace pendiente y define su contraseña al activar.
AUTH_ACTIVATION_EXPIRE=1440

# Producción: APP_URL=https://... es obligatorio y el SPA debe servirse en el
# mismo sitio que la API. Secure se fuerza en producción; SESSION_SECURE_COOKIE=false
# solo tiene efecto en local/testing y no desactiva Secure en producción. Un
# valor no booleano tampoco lo desactiva. SameSite=Lax es el valor correcto
# para el mismo origen; HttpOnly ya está activo.

APP_TIMEZONE=America/Bogota

# Limite de peticiones por minuto y usuario en la API (default 60 en produccion).
# En local se recomienda subirlo (600) porque la suite E2E abre muchas paginas.
API_RATE_LIMIT=600

# Contraseña compartida por las cuentas de demostración (DatabaseSeeder y
# `php artisan demo:preparar`). Solo se usa en local/testing. Por el carácter #,
# si la defines en .env debe ir entre comillas.
# DEMO_PASSWORD="ProyecTwin.Demo#2026"

# App Android publicada (ver config/app_version.php).
# El APK autorizado se sirve desde /apk/ProyecTWin.apk. Actualizar versionCode,
# SHA-256 y tamaño en cada release. ANDROID_APP_ENFORCE_MINIMUM solo con
# politica de actualizacion obligatoria.
ANDROID_APP_VERSION=1.4.0
ANDROID_APP_VERSION_CODE=5
ANDROID_APP_MIN_VERSION=1.3.0
ANDROID_APP_MIN_VERSION_CODE=4
ANDROID_APP_DOWNLOAD_URL=/apk/ProyecTWin.apk
ANDROID_APP_APK_SHA256=
ANDROID_APP_APK_SIZE=
ANDROID_APP_PUBLISHED_AT=
ANDROID_APP_ENFORCE_MINIMUM=false
ANDROID_APP_RELEASE_NOTES=
