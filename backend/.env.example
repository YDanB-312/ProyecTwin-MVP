APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Nunca true en producción: expone SQL, rutas y credenciales en los errores.
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Poner true cuando el sitio se sirva por HTTPS (cookie solo por TLS).
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo en local: el mensaje se escribe en storage/logs/laravel.log.
# Al desplegar: MAIL_MAILER=smtp (o un proveedor: Mailgun/SES/Postmark) con
# credenciales y un dominio verificado (SPF/DKIM). No hace falta cambiar codigo.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@proyecttwin.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173,127.0.0.1:4173

# Vigencia del token/sesión en minutos (24 h). 0 o vacío = sin expiración.
SANCTUM_EXPIRATION=1440

APP_TIMEZONE=America/Bogota

# Identidad institucional: vigencia del código de activación (minutos) y
# exposición del código en la respuesta (solo local/demo, sin correo).
IDENTIDAD_ACTIVACION_MINUTOS=4320
IDENTIDAD_EXPONER_CODIGO=true
IDENTIDAD_THROTTLE_LOGIN=5
IDENTIDAD_THROTTLE_ACTIVACION=3
IDENTIDAD_THROTTLE_RECUPERACION=5

# Limite de peticiones por minuto y usuario en la API (default 60 en produccion).
# En local se recomienda subirlo (600) porque la suite E2E abre muchas paginas.
API_RATE_LIMIT=600
